---
import Layout from '../layouts/Layout.astro';
import SkillCard from '../components/SkillCard.astro';
import { getCollection } from 'astro:content';

const allSkills = await getCollection('skills');

// Sort: by skillId numerically
const skills = allSkills.sort((a, b) => {
  const aId = a.data.skillId || a.id;
  const bId = b.data.skillId || b.id;
  return aId.localeCompare(bId, undefined, { numeric: true });
});

// Stats
const total = skills.length;
const active = skills.filter(s => s.data.status === 'active').length;
const draft = skills.filter(s => s.data.status === 'draft').length;
const notBuilt = skills.filter(s => s.data.status === 'not-built').length;

// Series list for filter
const seriesList = ['All', 'Foundation', 'Blueprints', 'Engineering Standards', 'Engineering Toolkit'];
const statusList = ['All', 'active', 'draft', 'not-built'];
---

<Layout title="Skill Catalog">
  <!-- Hero -->
  <section class="bg-white border-b border-[var(--color-cream-dark)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <h1 class="text-3xl sm:text-4xl font-black text-[var(--color-charcoal)] mb-3">
        AI Skill Catalog
      </h1>
      <p class="text-lg text-[var(--color-gray-warm)] max-w-2xl">
        Browse every skill in the True Legacy Homes taxonomy. Click any skill to see full documentation, usage guides, and examples.
      </p>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="bg-[var(--color-cream)] border-b border-[var(--color-cream-dark)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex flex-wrap gap-6 text-sm">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-teal)]"></span>
          <span class="text-[var(--color-charcoal)] font-medium">{total} Total Skills</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
          <span class="text-[var(--color-gray-warm)]">{active} Active</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
          <span class="text-[var(--color-gray-warm)]">{draft} Draft</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-gray-400"></span>
          <span class="text-[var(--color-gray-warm)]">{notBuilt} Planned</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Filters + Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Filter Controls -->
    <div class="flex flex-col sm:flex-row gap-3 mb-6" id="filters">
      <!-- Search -->
      <div class="flex-1">
        <input
          type="text"
          id="search-input"
          placeholder="Search skills..."
          class="w-full px-4 py-2.5 rounded-lg border border-[var(--color-cream-dark)] bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-teal)] focus:border-transparent"
        />
      </div>
      <!-- Series Filter -->
      <select id="series-filter" class="px-4 py-2.5 rounded-lg border border-[var(--color-cream-dark)] bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-teal)]">
        {seriesList.map(s => (
          <option value={s}>{s === 'All' ? 'All Series' : s}</option>
        ))}
      </select>
      <!-- Status Filter -->
      <select id="status-filter" class="px-4 py-2.5 rounded-lg border border-[var(--color-cream-dark)] bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-teal)]">
        {statusList.map(s => (
          <option value={s}>{s === 'All' ? 'All Statuses' : s === 'not-built' ? 'Planned' : s.charAt(0).toUpperCase() + s.slice(1)}</option>
        ))}
      </select>
    </div>

    <!-- Skills Grid -->
    <div id="skills-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {skills.map(skill => (
        <div
          class="skill-card-wrapper"
          data-name={skill.data.name?.toLowerCase()}
          data-skill-id={skill.data.skillId?.toLowerCase()}
          data-series={skill.data.series}
          data-status={skill.data.status}
          data-one-liner={skill.data.oneLiner?.toLowerCase()}
        >
          <SkillCard
            id={skill.id}
            skillId={skill.data.skillId || skill.id}
            name={skill.data.name}
            series={skill.data.series || 'Foundation'}
            status={skill.data.status || 'active'}
            audience={skill.data.audience || 'All Team Members'}
            oneLiner={skill.data.oneLiner || skill.data.description || ''}
          />
        </div>
      ))}
    </div>

    <!-- No results message -->
    <div id="no-results" class="hidden text-center py-12">
      <p class="text-[var(--color-gray-warm)] text-lg">No skills match your filters.</p>
      <button id="clear-filters" class="mt-3 text-[var(--color-teal-dark)] underline text-sm">Clear all filters</button>
    </div>
  </section>
</Layout>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const seriesFilter = document.getElementById('series-filter') as HTMLSelectElement;
  const statusFilter = document.getElementById('status-filter') as HTMLSelectElement;
  const grid = document.getElementById('skills-grid')!;
  const noResults = document.getElementById('no-results')!;
  const clearBtn = document.getElementById('clear-filters')!;

  function filterCards() {
    const query = searchInput.value.toLowerCase().trim();
    const series = seriesFilter.value;
    const status = statusFilter.value;
    const cards = grid.querySelectorAll('.skill-card-wrapper') as NodeListOf<HTMLElement>;
    let visible = 0;

    cards.forEach(card => {
      const name = card.dataset.name || '';
      const skillId = card.dataset.skillId || '';
      const oneLiner = card.dataset.oneLiner || '';
      const cardSeries = card.dataset.series || '';
      const cardStatus = card.dataset.status || '';

      const matchesSearch = !query || name.includes(query) || skillId.includes(query) || oneLiner.includes(query);
      const matchesSeries = series === 'All' || cardSeries === series;
      const matchesStatus = status === 'All' || cardStatus === status;

      if (matchesSearch && matchesSeries && matchesStatus) {
        card.style.display = '';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });

    noResults.classList.toggle('hidden', visible > 0);
  }

  searchInput.addEventListener('input', filterCards);
  seriesFilter.addEventListener('change', filterCards);
  statusFilter.addEventListener('change', filterCards);
  clearBtn.addEventListener('click', () => {
    searchInput.value = '';
    seriesFilter.value = 'All';
    statusFilter.value = 'All';
    filterCards();
  });
</script>
