---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allSkills = await getCollection('skills');
const base = import.meta.env.BASE_URL;

// Stats
const total = allSkills.length;
const active = allSkills.filter(s => s.data.status === 'active').length;
const draft = allSkills.filter(s => s.data.status === 'draft').length;

// Recently updated (sort by last_updated descending, take top 5)
const recent = [...allSkills]
  .filter(s => s.data.status !== 'not-built')
  .sort((a, b) => (b.data.last_updated || '').localeCompare(a.data.last_updated || ''))
  .slice(0, 5);

// Quick-start goals (mirrors Finder)
const quickStart = [
  { icon: '🎯', label: 'Define a problem', href: `${base}finder/`, desc: 'Scope and clarify before solving' },
  { icon: '🏗️', label: 'Build something new', href: `${base}finder/`, desc: 'Plan a new product or feature' },
  { icon: '⚡', label: 'Automate a workflow', href: `${base}finder/`, desc: 'Replace manual steps' },
  { icon: '📋', label: 'Document a process', href: `${base}finder/`, desc: 'Create an SOP or template' },
];
---

<Layout title="Home">
  <!-- Hero -->
  <section class="bg-white border-b border-[var(--color-cream-dark)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 text-center">
      <h1 class="text-4xl sm:text-5xl font-black text-[var(--color-charcoal)] mb-4 leading-tight">
        TLH AI Skill Hub
      </h1>
      <p class="text-xl text-[var(--color-gray-warm)] max-w-2xl mx-auto mb-8">
        Your guide to every AI skill at True Legacy Homes. Find the right skill, follow proven workflows, and get things done faster.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={`${base}finder/`} class="inline-flex items-center gap-2 px-6 py-3 bg-[var(--color-teal)] text-white font-bold rounded-lg hover:bg-[var(--color-teal-dark)] transition-colors no-underline text-sm">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          Find the Right Skill
        </a>
        <a href={`${base}catalog/`} class="inline-flex items-center gap-2 px-6 py-3 bg-white border-2 border-[var(--color-cream-dark)] text-[var(--color-charcoal)] font-bold rounded-lg hover:border-[var(--color-teal)] hover:text-[var(--color-teal-dark)] transition-colors no-underline text-sm">
          Browse All {total} Skills
        </a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="bg-[var(--color-cream)] border-b border-[var(--color-cream-dark)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-3 gap-4 text-center">
        <div>
          <span class="text-3xl font-black text-[var(--color-teal)]">{active}</span>
          <p class="text-sm text-[var(--color-gray-warm)] mt-1">Active Skills</p>
        </div>
        <div>
          <span class="text-3xl font-black text-[var(--color-charcoal)]">{total}</span>
          <p class="text-sm text-[var(--color-gray-warm)] mt-1">Total in Taxonomy</p>
        </div>
        <div>
          <span class="text-3xl font-black text-amber-600">4</span>
          <p class="text-sm text-[var(--color-gray-warm)] mt-1">Skill Series</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What Are You Trying to Do? -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="text-2xl font-black text-[var(--color-charcoal)] mb-2">What are you trying to do?</h2>
    <p class="text-[var(--color-gray-warm)] mb-6">Pick your goal and we'll point you to the right skills.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {quickStart.map(q => (
        <a href={q.href} class="bg-white rounded-xl border border-[var(--color-cream-dark)] p-5 hover:shadow-md hover:border-[var(--color-teal)] transition-all no-underline group">
          <span class="text-2xl block mb-2">{q.icon}</span>
          <h3 class="text-sm font-bold text-[var(--color-charcoal)] group-hover:text-[var(--color-teal-dark)]">{q.label}</h3>
          <p class="text-xs text-[var(--color-gray-warm)] mt-1">{q.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Top Workflows -->
  <section class="bg-white border-y border-[var(--color-cream-dark)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-2xl font-black text-[var(--color-charcoal)] mb-1">Common Workflows</h2>
          <p class="text-[var(--color-gray-warm)] text-sm">The most common multi-skill chains used at TLH.</p>
        </div>
        <a href={`${base}workflows/`} class="text-sm text-[var(--color-teal-dark)] font-medium hover:underline no-underline">View all →</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="rounded-xl border border-[var(--color-cream-dark)] p-5">
          <h3 class="font-bold text-[var(--color-charcoal)] mb-2">New Project from Scratch</h3>
          <div class="space-y-2 text-sm">
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-[var(--color-teal-light)] text-[var(--color-teal-dark)] flex items-center justify-center text-xs font-bold flex-shrink-0">1</span>
              <span class="text-[var(--color-gray-warm)]">Problem Definer</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-[var(--color-teal-light)] text-[var(--color-teal-dark)] flex items-center justify-center text-xs font-bold flex-shrink-0">2</span>
              <span class="text-[var(--color-gray-warm)]">New Product Planner</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-[var(--color-teal-light)] text-[var(--color-teal-dark)] flex items-center justify-center text-xs font-bold flex-shrink-0">3</span>
              <span class="text-[var(--color-gray-warm)]">Engineering Handoff Brief</span>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-[var(--color-cream-dark)] p-5">
          <h3 class="font-bold text-[var(--color-charcoal)] mb-2">Create a New SOP</h3>
          <div class="space-y-2 text-sm">
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-[var(--color-teal-light)] text-[var(--color-teal-dark)] flex items-center justify-center text-xs font-bold flex-shrink-0">1</span>
              <span class="text-[var(--color-gray-warm)]">Problem Definer</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-[var(--color-teal-light)] text-[var(--color-teal-dark)] flex items-center justify-center text-xs font-bold flex-shrink-0">2</span>
              <span class="text-[var(--color-gray-warm)]">SOP Creator</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-[var(--color-teal-light)] text-[var(--color-teal-dark)] flex items-center justify-center text-xs font-bold flex-shrink-0">3</span>
              <span class="text-[var(--color-gray-warm)]">Quality Checker</span>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-[var(--color-cream-dark)] p-5">
          <h3 class="font-bold text-[var(--color-charcoal)] mb-2">Build an Automation</h3>
          <div class="space-y-2 text-sm">
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-[var(--color-teal-light)] text-[var(--color-teal-dark)] flex items-center justify-center text-xs font-bold flex-shrink-0">1</span>
              <span class="text-[var(--color-gray-warm)]">Problem Definer</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-[var(--color-teal-light)] text-[var(--color-teal-dark)] flex items-center justify-center text-xs font-bold flex-shrink-0">2</span>
              <span class="text-[var(--color-gray-warm)]">Automation Planner</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-[var(--color-teal-light)] text-[var(--color-teal-dark)] flex items-center justify-center text-xs font-bold flex-shrink-0">3</span>
              <span class="text-[var(--color-gray-warm)]">Engineering Handoff Brief</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Recently Updated -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-2xl font-black text-[var(--color-charcoal)] mb-1">Recently Updated</h2>
        <p class="text-[var(--color-gray-warm)] text-sm">The latest skill additions and updates.</p>
      </div>
      <a href={`${base}catalog/`} class="text-sm text-[var(--color-teal-dark)] font-medium hover:underline no-underline">View all →</a>
    </div>
    <div class="space-y-3">
      {recent.map(skill => (
        <a href={`${base}skills/${skill.id}/`} class="flex items-center gap-4 bg-white rounded-lg border border-[var(--color-cream-dark)] px-5 py-4 hover:shadow-md hover:border-[var(--color-teal)] transition-all no-underline group">
          <span class="text-sm font-mono text-[var(--color-teal-dark)] w-10 flex-shrink-0">{skill.data.skillId}</span>
          <div class="flex-1 min-w-0">
            <h3 class="text-sm font-bold text-[var(--color-charcoal)] group-hover:text-[var(--color-teal-dark)]">{skill.data.name}</h3>
            <p class="text-xs text-[var(--color-gray-warm)] truncate">{skill.data.oneLiner}</p>
          </div>
          <span class:list={[
            "text-xs font-medium px-2 py-0.5 rounded-full capitalize flex-shrink-0",
            skill.data.status === 'active' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'
          ]}>{skill.data.status}</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
