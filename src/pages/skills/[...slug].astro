---
import Layout from '../../layouts/Layout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const skills = await getCollection('skills');
  return skills.map(skill => ({
    params: { slug: skill.id },
    props: { skill },
  }));
}

const { skill } = Astro.props;
const { Content } = await render(skill);
const base = import.meta.env.BASE_URL;

const seriesColors: Record<string, { bg: string; text: string; label: string }> = {
  'Foundation': { bg: 'bg-[var(--color-teal)]', text: 'text-white', label: '1.xx Foundation' },
  'Blueprints': { bg: 'bg-[var(--color-navy)]', text: 'text-white', label: '2.xx Blueprints' },
  'Engineering Standards': { bg: 'bg-purple-600', text: 'text-white', label: '3.xx Standards' },
  'Engineering Toolkit': { bg: 'bg-amber-600', text: 'text-white', label: '4.xx Toolkit' },
};

const sc = seriesColors[skill.data.series || 'Foundation'] || seriesColors['Foundation'];
---

<Layout title={skill.data.name}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm">
      <a href={`${base}catalog/`} class="text-[var(--color-teal-dark)] hover:underline">Catalog</a>
      <span class="text-[var(--color-gray-warm)] mx-2">/</span>
      <span class="text-[var(--color-gray-warm)]">{skill.data.name}</span>
    </nav>

    <!-- Header -->
    <div class="bg-white rounded-xl border border-[var(--color-cream-dark)] p-6 sm:p-8 mb-8">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class:list={["text-xs font-bold px-3 py-1 rounded-full", sc.bg, sc.text]}>{sc.label}</span>
        <StatusBadge status={skill.data.status || 'active'} />
      </div>
      <div class="mb-2">
        <span class="text-sm font-mono text-[var(--color-teal-dark)]">{skill.data.skillId || skill.id}</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-[var(--color-charcoal)] mb-3">{skill.data.name}</h1>
      {skill.data.oneLiner && (
        <p class="text-lg text-[var(--color-gray-warm)] leading-relaxed">{skill.data.oneLiner}</p>
      )}

      <!-- Metadata grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6 pt-6 border-t border-[var(--color-cream)]">
        <div>
          <span class="text-xs text-[var(--color-gray-warm)] block mb-1">Audience</span>
          <span class="text-sm font-medium text-[var(--color-charcoal)]">{skill.data.audience || 'All Team Members'}</span>
        </div>
        <div>
          <span class="text-xs text-[var(--color-gray-warm)] block mb-1">Version</span>
          <span class="text-sm font-medium text-[var(--color-charcoal)]">{skill.data.version || '—'}</span>
        </div>
        <div>
          <span class="text-xs text-[var(--color-gray-warm)] block mb-1">Last Updated</span>
          <span class="text-sm font-medium text-[var(--color-charcoal)]">{skill.data.last_updated || '—'}</span>
        </div>
        <div>
          <span class="text-xs text-[var(--color-gray-warm)] block mb-1">Series</span>
          <span class="text-sm font-medium text-[var(--color-charcoal)]">{skill.data.series || '—'}</span>
        </div>
      </div>
    </div>

    <!-- Content -->
    <div class="bg-white rounded-xl border border-[var(--color-cream-dark)] p-6 sm:p-8">
      <div class="prose max-w-none">
        <Content />
      </div>
    </div>

    <!-- Back link -->
    <div class="mt-8 text-center">
      <a href={`${base}catalog/`} class="inline-flex items-center gap-2 text-[var(--color-teal-dark)] hover:underline text-sm font-medium">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Back to all skills
      </a>
    </div>
  </div>
</Layout>
