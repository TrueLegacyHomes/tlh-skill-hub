---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getAllGoalsWithSkills } from '../lib/db/goals';

const base = import.meta.env.BASE_URL;
const supabase = Astro.locals.supabase;
const profile = Astro.locals.profile ?? null;

// Fetch goals with ordered skills from Supabase
const goalsWithSkills = await getAllGoalsWithSkills(supabase);

// Fetch skill metadata from the content collection
const allContentSkills = await getCollection('skills');

// Build skills list — include ALL skills for display metadata (names, oneLiner),
// even "not-built" ones, since goals may reference them
const skillsList = allContentSkills
  .sort((a, b) => (a.data.skillId || '').localeCompare(b.data.skillId || '', undefined, { numeric: true }))
  .map(s => ({
    skillId: s.data.skillId || s.id,
    contentSlug: s.id,
    name: s.data.name,
    series: s.data.series || 'Foundation',
    oneLiner: s.data.oneLiner || '',
  }));
---

<Layout title="Common Workflows">
  <section class="bg-white border-b border-[var(--color-cream-dark)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <h1 class="text-3xl font-black text-[var(--color-charcoal)] mb-3">Common Workflows</h1>
      <p class="text-lg text-[var(--color-gray-warm)] max-w-2xl">
        These are the goals your team works toward, and the skill chains to get there. Each workflow shows you exactly which skills to use and in what order.
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div id="workflows-mount"
      data-goals={JSON.stringify(goalsWithSkills)}
      data-all-skills={JSON.stringify(skillsList)}
      data-current-user={JSON.stringify(profile)}
      data-base-url={base}
    >
      <!-- Loading skeleton shown before Preact hydrates -->
      <div class="space-y-6 animate-pulse">
        {goalsWithSkills.filter(g => g.skills.length > 0).map(() => (
          <div class="bg-white rounded-xl border border-[var(--color-cream-dark)] h-32"></div>
        ))}
      </div>
    </div>
  </section>

  <script>
    const mount = document.getElementById('workflows-mount');
    if (mount) {
      const props = {
        initialGoals: JSON.parse(mount.dataset.goals || '[]'),
        allSkills: JSON.parse(mount.dataset.allSkills || '[]'),
        currentUser: JSON.parse(mount.dataset.currentUser || 'null'),
        baseUrl: mount.dataset.baseUrl || '/',
      };

      import('../components/workflows/WorkflowsManager.tsx').then(({ default: WorkflowsManager }) => {
        import('preact').then(({ render, h }) => {
          render(h(WorkflowsManager, props), mount);
        });
      });
    }
  </script>
</Layout>
