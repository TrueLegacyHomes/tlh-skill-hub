---
export const prerender = false;

import { createSupabaseServerClient } from '../../lib/supabase';

const base = import.meta.env.BASE_URL;

// Supabase PKCE flow sends the auth code as a query parameter
const code = Astro.url.searchParams.get('code');

if (code) {
  const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
  const { error } = await supabase.auth.exchangeCodeForSession(code);

  if (!error) {
    return Astro.redirect(`${base}board/`);
  }

  // If exchange failed, redirect to login with error hint
  console.error('Auth code exchange failed:', error.message);
  return Astro.redirect(`${base}login/`);
}

// No code in URL — redirect to login
return Astro.redirect(`${base}login/`);
---
