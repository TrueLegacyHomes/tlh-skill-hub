---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Signing in...">
  <div class="max-w-md mx-auto px-4 py-20 text-center">
    <div class="bg-white rounded-2xl shadow-sm border border-[var(--color-cream-dark)] p-8">
      <div class="animate-spin w-8 h-8 border-4 border-[var(--color-teal)] border-t-transparent rounded-full mx-auto mb-4"></div>
      <p class="text-[var(--color-gray-warm)]">Completing sign in...</p>
    </div>
  </div>

  <script define:vars={{ base }}>
    import { createClient } from '@supabase/supabase-js';

    const supabase = createClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    );

    // Handle the OAuth callback
    supabase.auth.onAuthStateChange((event) => {
      if (event === 'SIGNED_IN') {
        window.location.href = `${base}board/`;
      }
    });

    // Also check if already signed in (redirect may have set cookies)
    supabase.auth.getSession().then(({ data: { session } }) => {
      if (session) {
        window.location.href = `${base}board/`;
      }
    });
  </script>
</Layout>
