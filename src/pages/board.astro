---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import type { Profile } from '../lib/types';

const supabase = Astro.locals.supabase;
const profile = Astro.locals.profile;

// Get the default board
const { data: board } = await supabase
  .from('boards')
  .select('id')
  .eq('is_default', true)
  .single();

const boardId = board?.id ?? '';

// Get columns ordered by position
const { data: columns } = await supabase
  .from('columns')
  .select('*')
  .eq('board_id', boardId)
  .order('position', { ascending: true });

// Get all cards for this board
const { data: cards } = await supabase
  .from('cards')
  .select('*')
  .eq('board_id', boardId)
  .order('composite_score', { ascending: false });

// Get all active profiles for display
const { data: allProfiles } = await supabase
  .from('profiles')
  .select('*')
  .eq('is_active', true);

// Build a lookup map: { id → profile }
const profilesMap: Record<string, Profile> = {};
(allProfiles ?? []).forEach((p: Profile) => {
  profilesMap[p.id] = p;
});

---

<Layout title="Workflow Board">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h1 class="text-2xl font-bold text-[var(--color-charcoal)]">Workflow Board</h1>
        <p class="text-sm text-[var(--color-gray-warm)]">
          Welcome, {profile?.full_name || 'Team Member'}
          <span class="ml-2 px-2 py-0.5 text-xs font-medium bg-[var(--color-teal-light)] text-[var(--color-teal-dark)] rounded-full">
            {profile?.role || 'team_member'}
          </span>
        </p>
      </div>
    </div>

    {!board ? (
      <!-- No board found — database probably not set up -->
      <div class="bg-white rounded-2xl shadow-sm border border-[var(--color-cream-dark)] p-12 text-center max-w-lg mx-auto">
        <p class="text-4xl mb-3">🗄️</p>
        <h3 class="text-lg font-bold text-[var(--color-charcoal)] mb-2">Database Setup Needed</h3>
        <p class="text-sm text-[var(--color-gray-warm)] mb-4">
          The board hasn't been set up yet. An admin needs to run the database migration
          in the Supabase SQL Editor to create the tables, columns, and seed data.
        </p>
        <p class="text-xs text-[var(--color-gray-warm)]">
          File: <code class="bg-[var(--color-cream)] px-2 py-0.5 rounded">supabase/migration-001-init.sql</code>
        </p>
      </div>
    ) : (
      <!-- Kanban Board Preact island -->
      <div id="kanban-board-mount"
        data-board-id={boardId}
        data-columns={JSON.stringify(columns ?? [])}
        data-cards={JSON.stringify(cards ?? [])}
        data-profiles={JSON.stringify(profilesMap)}
        data-current-user={JSON.stringify(profile)}
      >
        <!-- Loading skeleton shown before Preact hydrates -->
        <div class="flex gap-3 overflow-x-auto pb-4">
          {(columns ?? []).map(() => (
            <div class="flex flex-col min-w-[260px] max-w-[300px] bg-[var(--color-cream)] rounded-xl animate-pulse" style="flex: 1 0 260px">
              <div class="h-10 rounded-t-xl bg-[var(--color-gray-warm)]/20"></div>
              <div class="p-2 space-y-2">
                <div class="h-20 bg-white/60 rounded-lg"></div>
                <div class="h-20 bg-white/40 rounded-lg"></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>

  <script>
    const mount = document.getElementById('kanban-board-mount');
    if (mount) {
      const props = {
        boardId: mount.dataset.boardId,
        initialColumns: JSON.parse(mount.dataset.columns || '[]'),
        initialCards: JSON.parse(mount.dataset.cards || '[]'),
        profiles: JSON.parse(mount.dataset.profiles || '{}'),
        currentUser: JSON.parse(mount.dataset.currentUser || '{}'),
      };

      import('../components/board/KanbanBoard.tsx').then(({ default: KanbanBoard }) => {
        import('preact').then(({ render, h }) => {
          render(h(KanbanBoard, props), mount);
        });
      });
    }
  </script>
</Layout>
