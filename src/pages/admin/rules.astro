---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import type { ApprovalRule, Profile } from '../../lib/types';

const supabase = Astro.locals.supabase;
const profile = Astro.locals.profile;

// Get all approval rules
const { data: allRules } = await supabase
  .from('approval_rules')
  .select('*')
  .order('priority', { ascending: true });

const rules: ApprovalRule[] = allRules ?? [];

// Get all profiles for route-to-user dropdown
const { data: allProfiles } = await supabase
  .from('profiles')
  .select('id, full_name, role')
  .eq('is_active', true)
  .order('full_name');

const users: { id: string; full_name: string; role: string }[] = allProfiles ?? [];

const CARD_TYPES = [
  { value: '', label: 'Any Type' },
  { value: 'problem_definition', label: 'Problem Definition' },
  { value: 'sop', label: 'SOP' },
  { value: 'new_product_plan', label: 'New Product Plan' },
  { value: 'system_change_request', label: 'System Change Request' },
  { value: 'report_dashboard', label: 'Report/Dashboard' },
  { value: 'automation_plan', label: 'Automation Plan' },
  { value: 'template', label: 'Template' },
  { value: 'skill_improvement', label: 'Skill Improvement' },
  { value: 'engineering_build', label: 'Engineering Build' },
];

const DEPARTMENTS = [
  { value: '', label: 'Any Department' },
  { value: 'executive', label: 'Executive' },
  { value: 'operations', label: 'Operations' },
  { value: 'interior_design', label: 'Interior Design' },
  { value: 'estate_sales', label: 'Estate Sales' },
  { value: 'home_acquisitions', label: 'Home Acquisitions' },
  { value: 'care_placement', label: 'Care Placement' },
  { value: 'marketing', label: 'Marketing' },
  { value: 'engineering', label: 'Engineering' },
];

const ROLES = [
  { value: '', label: 'Any Role' },
  { value: 'admin', label: 'Admin' },
  { value: 'department_head', label: 'Dept Head' },
  { value: 'team_member', label: 'Team Member' },
  { value: 'engineering', label: 'Engineering' },
];

const formatLabel = (s: string | null) => {
  if (!s) return '—';
  return s.replace(/_/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
};
---

<Layout title="Approval Rules">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
      <div class="flex items-center gap-2 mb-1">
        <a href="/board/" class="text-sm text-[var(--color-teal)] hover:underline">&larr; Board</a>
        <span class="text-[var(--color-gray-warm)]">/</span>
        <span class="text-sm text-[var(--color-gray-warm)]">Admin</span>
      </div>
      <h1 class="text-2xl font-bold text-[var(--color-charcoal)]">Approval Rules</h1>
      <p class="text-sm text-[var(--color-gray-warm)]">Configure how cards are routed for approval. Rules are checked in priority order — first match wins.</p>
    </div>

    <!-- Nav -->
    <div class="flex gap-2 mb-6">
      <a href="/admin/users/" class="px-4 py-2 text-sm font-medium text-[var(--color-charcoal)] border border-[var(--color-cream-dark)] rounded-lg hover:bg-[var(--color-cream)] no-underline">Users</a>
      <a href="/admin/rules/" class="px-4 py-2 text-sm font-medium text-white bg-[var(--color-teal)] rounded-lg no-underline">Approval Rules</a>
    </div>

    <!-- Add New Rule -->
    <div class="bg-white rounded-2xl shadow-sm border border-[var(--color-cream-dark)] p-6 mb-6">
      <h2 class="text-lg font-bold text-[var(--color-charcoal)] mb-4">Add New Rule</h2>
      <form id="new-rule-form" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="text-xs font-bold text-[var(--color-gray-warm)] uppercase">Rule Name *</label>
            <input type="text" id="rule-name" required class="mt-1 w-full text-sm border border-[var(--color-cream-dark)] rounded-lg px-3 py-2 focus:outline-none focus:border-[var(--color-teal)]" placeholder="e.g., SOPs → Engineering Queue" />
          </div>
          <div>
            <label class="text-xs font-bold text-[var(--color-gray-warm)] uppercase">Priority</label>
            <input type="number" id="rule-priority" min="1" value="50" class="mt-1 w-full text-sm border border-[var(--color-cream-dark)] rounded-lg px-3 py-2 focus:outline-none focus:border-[var(--color-teal)]" />
          </div>
        </div>

        <div>
          <label class="text-xs font-bold text-[var(--color-gray-warm)] uppercase">Description</label>
          <input type="text" id="rule-description" class="mt-1 w-full text-sm border border-[var(--color-cream-dark)] rounded-lg px-3 py-2 focus:outline-none focus:border-[var(--color-teal)]" placeholder="Why does this rule exist?" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="text-xs font-bold text-[var(--color-gray-warm)] uppercase">Match Card Type</label>
            <select id="rule-match-type" class="mt-1 w-full text-sm border border-[var(--color-cream-dark)] rounded-lg px-3 py-2 bg-white">
              {CARD_TYPES.map(t => <option value={t.value}>{t.label}</option>)}
            </select>
          </div>
          <div>
            <label class="text-xs font-bold text-[var(--color-gray-warm)] uppercase">Match Department</label>
            <select id="rule-match-dept" class="mt-1 w-full text-sm border border-[var(--color-cream-dark)] rounded-lg px-3 py-2 bg-white">
              {DEPARTMENTS.map(d => <option value={d.value}>{d.label}</option>)}
            </select>
          </div>
          <div>
            <label class="text-xs font-bold text-[var(--color-gray-warm)] uppercase">Route To Role</label>
            <select id="rule-route-role" class="mt-1 w-full text-sm border border-[var(--color-cream-dark)] rounded-lg px-3 py-2 bg-white">
              {ROLES.map(r => <option value={r.value}>{r.label}</option>)}
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="flex items-center gap-2">
            <input type="checkbox" id="rule-requires-approval" class="rounded" />
            <label for="rule-requires-approval" class="text-sm text-[var(--color-charcoal)]">Requires Approval</label>
          </div>
          <div class="flex items-center gap-2">
            <input type="checkbox" id="rule-auto-engineering" class="rounded" />
            <label for="rule-auto-engineering" class="text-sm text-[var(--color-charcoal)]">Auto → Engineering Queue</label>
          </div>
        </div>

        <div class="flex gap-2">
          <button type="submit" class="px-4 py-2 text-sm font-bold text-white bg-[var(--color-teal)] rounded-lg hover:bg-[var(--color-teal-dark)] transition-colors">
            Create Rule
          </button>
        </div>
      </form>
    </div>

    <!-- Rules list -->
    <div class="space-y-4">
      {rules.map((rule, index) => (
        <div class="bg-white rounded-xl shadow-sm border border-[var(--color-cream-dark)] p-5" data-rule-id={rule.id}>
          <div class="flex items-start justify-between mb-3">
            <div>
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold px-2 py-0.5 rounded bg-[var(--color-cream)] text-[var(--color-gray-warm)]">
                  #{rule.priority}
                </span>
                <h3 class="text-sm font-bold text-[var(--color-charcoal)]">{rule.name}</h3>
                {!rule.is_active && (
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-red-100 text-red-600 font-medium">Disabled</span>
                )}
              </div>
              {rule.description && (
                <p class="text-xs text-[var(--color-gray-warm)] mt-1">{rule.description}</p>
              )}
            </div>
            <div class="flex items-center gap-2">
              <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${
                rule.requires_approval ? 'bg-orange-100 text-orange-700' : 'bg-green-100 text-green-700'
              }`}>
                {rule.requires_approval ? 'Needs Approval' : 'Auto-flow'}
              </span>
            </div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div>
              <span class="text-[10px] font-bold text-[var(--color-gray-warm)] uppercase">Match Type</span>
              <p class="text-[var(--color-charcoal)] mt-0.5">{formatLabel(rule.match_card_type)}</p>
            </div>
            <div>
              <span class="text-[10px] font-bold text-[var(--color-gray-warm)] uppercase">Match Dept</span>
              <p class="text-[var(--color-charcoal)] mt-0.5">{formatLabel(rule.match_department)}</p>
            </div>
            <div>
              <span class="text-[10px] font-bold text-[var(--color-gray-warm)] uppercase">Route To</span>
              <p class="text-[var(--color-charcoal)] mt-0.5">
                {rule.route_to_user_id
                  ? users.find(u => u.id === rule.route_to_user_id)?.full_name || 'Specific user'
                  : rule.route_to_role
                    ? formatLabel(rule.route_to_role)
                    : '—'}
              </p>
            </div>
            <div>
              <span class="text-[10px] font-bold text-[var(--color-gray-warm)] uppercase">Then</span>
              <p class="text-[var(--color-charcoal)] mt-0.5">
                {rule.auto_move_to_engineering ? 'Auto → Engineering Queue' : formatLabel(rule.next_status)}
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2 mt-3 pt-3 border-t border-[var(--color-cream-dark)]">
            <button
              data-toggle-rule={rule.id}
              data-active={rule.is_active ? 'true' : 'false'}
              class="text-xs px-3 py-1 rounded font-medium transition-colors border border-[var(--color-cream-dark)] hover:bg-[var(--color-cream)]"
            >
              {rule.is_active ? 'Disable' : 'Enable'}
            </button>
            <button
              data-delete-rule={rule.id}
              class="text-xs px-3 py-1 rounded font-medium text-red-600 hover:bg-red-50 transition-colors border border-red-200"
            >
              Delete
            </button>
          </div>
        </div>
      ))}

      {rules.length === 0 && (
        <div class="bg-white rounded-2xl shadow-sm border border-[var(--color-cream-dark)] p-12 text-center">
          <p class="text-4xl mb-3">📋</p>
          <h3 class="text-lg font-bold text-[var(--color-charcoal)] mb-2">No Approval Rules</h3>
          <p class="text-sm text-[var(--color-gray-warm)] max-w-md mx-auto mb-4">
            Without rules, all submitted cards stay in "Submitted" until an admin manually moves them.
            Add rules to automatically route cards for approval or engineering.
          </p>
          <button
            id="seed-rules-btn"
            class="px-4 py-2 text-sm font-bold text-white bg-[var(--color-teal)] rounded-lg hover:bg-[var(--color-teal-dark)] transition-colors"
          >
            Create Default Rules
          </button>
        </div>
      )}
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase';

    // Toggle rule active/inactive
    document.querySelectorAll('[data-toggle-rule]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const ruleId = (btn as HTMLElement).dataset.toggleRule;
        const isActive = (btn as HTMLElement).dataset.active === 'true';
        if (!ruleId) return;

        const { error } = await supabase
          .from('approval_rules')
          .update({ is_active: !isActive })
          .eq('id', ruleId);

        if (error) {
          alert('Failed to update rule. Check console.');
          console.error('Toggle rule error:', error.message);
        } else {
          window.location.reload();
        }
      });
    });

    // Delete rule
    document.querySelectorAll('[data-delete-rule]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const ruleId = (btn as HTMLElement).dataset.deleteRule;
        if (!ruleId) return;

        if (!confirm('Are you sure you want to delete this rule?')) return;

        const { error } = await supabase
          .from('approval_rules')
          .delete()
          .eq('id', ruleId);

        if (error) {
          alert('Failed to delete rule. Check console.');
          console.error('Delete rule error:', error.message);
        } else {
          window.location.reload();
        }
      });
    });

    // Create new rule
    document.getElementById('new-rule-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const name = (document.getElementById('rule-name') as HTMLInputElement).value.trim();
      if (!name) return;

      const newRule: Record<string, unknown> = {
        name,
        description: (document.getElementById('rule-description') as HTMLInputElement).value.trim() || null,
        priority: parseInt((document.getElementById('rule-priority') as HTMLInputElement).value) || 50,
        match_card_type: (document.getElementById('rule-match-type') as HTMLSelectElement).value || null,
        match_department: (document.getElementById('rule-match-dept') as HTMLSelectElement).value || null,
        route_to_role: (document.getElementById('rule-route-role') as HTMLSelectElement).value || null,
        requires_approval: (document.getElementById('rule-requires-approval') as HTMLInputElement).checked,
        auto_move_to_engineering: (document.getElementById('rule-auto-engineering') as HTMLInputElement).checked,
        next_status: (document.getElementById('rule-auto-engineering') as HTMLInputElement).checked
          ? 'engineering_queued'
          : (document.getElementById('rule-requires-approval') as HTMLInputElement).checked
            ? 'under_review'
            : 'submitted',
        is_active: true,
      };

      const { error } = await supabase.from('approval_rules').insert(newRule);

      if (error) {
        console.error('Failed to create rule:', error.message);
        alert('Failed to create rule. Check console.');
      } else {
        window.location.reload();
      }
    });

    // Seed default rules based on the plan's routing table
    document.getElementById('seed-rules-btn')?.addEventListener('click', async () => {
      const defaultRules = [
        {
          name: 'Skill Improvements → Admin Review',
          description: 'Affects published skills in the live system',
          match_card_type: 'skill_improvement',
          requires_approval: true,
          route_to_role: 'admin',
          next_status: 'under_review',
          auto_move_to_engineering: false,
          priority: 1,
          is_active: true,
        },
        {
          name: 'System Changes → Admin Review',
          description: 'Changes to existing production systems',
          match_card_type: 'system_change_request',
          requires_approval: true,
          route_to_role: 'admin',
          next_status: 'under_review',
          auto_move_to_engineering: false,
          priority: 2,
          is_active: true,
        },
        {
          name: 'New Product Plans → Admin Review',
          description: 'High-stakes decisions with cross-cutting impact',
          match_card_type: 'new_product_plan',
          requires_approval: true,
          route_to_role: 'admin',
          next_status: 'under_review',
          auto_move_to_engineering: false,
          priority: 3,
          is_active: true,
        },
        {
          name: 'Problem Definitions → Engineering Queue',
          description: 'Defines the problem, does not commit to a solution',
          match_card_type: 'problem_definition',
          requires_approval: false,
          next_status: 'engineering_queued',
          auto_move_to_engineering: true,
          priority: 4,
          is_active: true,
        },
        {
          name: 'Automation Plans → Engineering Queue',
          description: 'Already scoped by the skill',
          match_card_type: 'automation_plan',
          requires_approval: false,
          next_status: 'engineering_queued',
          auto_move_to_engineering: true,
          priority: 5,
          is_active: true,
        },
        {
          name: 'Reports/Dashboards → Engineering Queue',
          description: 'Low risk, well-defined deliverables',
          match_card_type: 'report_dashboard',
          requires_approval: false,
          next_status: 'engineering_queued',
          auto_move_to_engineering: true,
          priority: 6,
          is_active: true,
        },
        {
          name: 'Templates → Done',
          description: 'Documentation only, no engineering needed',
          match_card_type: 'template',
          requires_approval: false,
          next_status: 'done',
          auto_move_to_engineering: false,
          priority: 7,
          is_active: true,
        },
        {
          name: 'SOPs → Engineering Queue (default)',
          description: 'May need engineering depending on content',
          match_card_type: 'sop',
          requires_approval: false,
          next_status: 'engineering_queued',
          auto_move_to_engineering: true,
          priority: 8,
          is_active: true,
        },
      ];

      const { error } = await supabase.from('approval_rules').insert(defaultRules);

      if (error) {
        console.error('Failed to seed rules:', error.message);
        alert('Failed to create rules. Check console.');
      } else {
        window.location.reload();
      }
    });
  </script>
</Layout>
