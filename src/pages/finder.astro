---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getAllGoalsWithSkills } from '../lib/db/goals';

const base = import.meta.env.BASE_URL;
const supabase = Astro.locals.supabase;

// Build skill data from content collection (always needed for metadata + prompt generation)
const allSkills = await getCollection('skills');
const skillsData = allSkills
  .filter(s => s.data.status !== 'not-built')
  .sort((a, b) => (a.data.skillId || '').localeCompare(b.data.skillId || '', undefined, { numeric: true }))
  .map(s => ({
    id: s.id,
    name: s.data.name,
    skillId: s.data.skillId || s.id,
    series: s.data.series || 'Foundation',
    status: s.data.status || 'active',
    audience: s.data.audience || 'All Team Members',
    oneLiner: s.data.oneLiner || '',
    recommendedFor: s.data.recommendedFor || [],
    githubPath: s.data.githubPath || '',
  }));

// Try to load goals from Supabase; fall back to frontmatter if unavailable
let goalSkillsMap: Record<string, string[]> = {};
let goalLabels: Record<string, string> = {};
let goalDescriptions: Record<string, string> = {};

interface GoalButtonData {
  slug: string;
  name: string;
  description: string;
}
let goalButtons: GoalButtonData[] = [];

const goalsWithSkills = await getAllGoalsWithSkills(supabase);

if (goalsWithSkills.length > 0) {
  // ── Supabase-driven (primary) ──
  for (const goal of goalsWithSkills) {
    goalSkillsMap[goal.slug] = goal.skills.map(gs => gs.skill_id);
    goalLabels[goal.slug] = goal.parent_name
      ? `${goal.parent_name} > ${goal.name}`
      : goal.name;
    goalDescriptions[goal.slug] = goal.description || '';
    goalButtons.push({
      slug: goal.slug,
      name: goal.parent_name ? `${goal.parent_name} > ${goal.name}` : goal.name,
      description: goal.description || '',
    });
  }
} else {
  // ── Fallback: frontmatter-driven (legacy) ──
  const fallbackGoals = [
    { slug: 'define', name: 'Define a problem', description: 'Scope and clarify an issue before solving it' },
    { slug: 'build', name: 'Build something new', description: 'Create a new product, process, or system' },
    { slug: 'automate', name: 'Automate a workflow', description: 'Reduce manual steps with automation' },
    { slug: 'document', name: 'Document a process', description: 'Create an SOP, template, or guide' },
    { slug: 'report', name: 'Create a report or dashboard', description: 'Track metrics and visualize data' },
    { slug: 'change', name: 'Request a system change', description: 'Modify an existing system or platform' },
    { slug: 'improve', name: 'Improve AI skills', description: 'Build, check, or manage skills themselves' },
    { slug: 'reference', name: 'Look up company info', description: 'Brand, people, tools, or company details' },
  ];

  const fallbackDescriptions: Record<string, string> = {
    define: 'Start by clearly defining the problem, then move to the right blueprint skill.',
    build: 'Define the problem first, plan the product, then create a handoff brief for engineering.',
    automate: 'Define the problem first, then plan the automation and reference your tools.',
    document: 'Create SOPs or templates with standardized formats.',
    report: 'Plan your report or dashboard with the right metrics and data sources.',
    change: 'Define the problem first, then submit a structured change request.',
    improve: 'Use the skill builder to create new skills, quality checker to validate, and memory manager for context.',
    reference: 'These foundational skills provide company context and information.',
  };

  for (const g of fallbackGoals) {
    const matching = skillsData
      .filter(s => s.recommendedFor.includes(g.slug))
      .sort((a, b) => {
        const seriesA = a.skillId.startsWith('2') ? 0 : 1;
        const seriesB = b.skillId.startsWith('2') ? 0 : 1;
        if (seriesA !== seriesB) return seriesA - seriesB;
        return a.skillId.localeCompare(b.skillId, undefined, { numeric: true });
      })
      .map(s => s.skillId);
    goalSkillsMap[g.slug] = matching;
    goalLabels[g.slug] = g.name;
    goalDescriptions[g.slug] = fallbackDescriptions[g.slug] || g.description;
    goalButtons.push(g);
  }
}
---

<Layout title="Skill Finder">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <h1 class="text-3xl font-black text-[var(--color-charcoal)] mb-3">Skill Finder</h1>
    <p class="text-lg text-[var(--color-gray-warm)] mb-8">
      Answer a few questions to find the right skill for your project.
    </p>

    <!-- Wizard -->
    <div id="wizard" class="space-y-6">
      <!-- Step 1: Choose a Goal (dynamic from DB or fallback) -->
      <div class="wizard-step bg-white rounded-xl border border-[var(--color-cream-dark)] p-6" data-step="1">
        <h2 class="text-lg font-bold text-[var(--color-charcoal)] mb-4">Choose a Goal</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {goalButtons.map(g => (
            <button
              class="goal-btn px-4 py-3 rounded-lg border-2 border-[var(--color-cream-dark)] text-left text-sm font-medium hover:border-[var(--color-teal)] hover:bg-[var(--color-teal-light)] transition-colors"
              data-goal={g.slug}
            >
              <span class="block font-bold text-[var(--color-charcoal)]">{g.name}</span>
              <span class="text-[var(--color-gray-warm)]">{g.description}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Results -->
      <div id="results" class="hidden">
        <div class="bg-[var(--color-teal-light)] rounded-xl border border-[var(--color-teal)] p-6">
          <h2 class="text-lg font-bold text-[var(--color-teal-dark)] mb-1">Recommended Skills</h2>
          <p class="text-sm text-[var(--color-gray-warm)] mb-4">Based on your goal, here are the skills you should use:</p>
          <div id="results-list" class="space-y-3"></div>
        </div>
        <button id="reset-btn" class="mt-4 text-sm text-[var(--color-teal-dark)] underline">Start over</button>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ skillsData, goalSkillsMap, goalLabels, goalDescriptions, base }}>
  // Goal → skill ID mappings (from Supabase or frontmatter fallback)
  const goalSkills = goalSkillsMap;

  document.querySelectorAll('.goal-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const goal = btn.dataset.goal;
      showResults(goal);
    });
  });

  function showResults(goal) {
    const recommended = goalSkills[goal] || [];
    const desc = goalDescriptions[goal] || '';
    const resultsList = document.getElementById('results-list');
    const resultsDiv = document.getElementById('results');

    // Highlight selected button
    document.querySelectorAll('.goal-btn').forEach(b => {
      b.classList.remove('border-[var(--color-teal)]', 'bg-[var(--color-teal-light)]');
    });
    const selectedBtn = document.querySelector(`[data-goal="${goal}"]`);
    if (selectedBtn) {
      selectedBtn.classList.add('border-[var(--color-teal)]', 'bg-[var(--color-teal-light)]');
    }

    // Build results
    const matchedSkills = recommended
      .map(id => skillsData.find(s => s.skillId === id))
      .filter(Boolean);

    resultsList.innerHTML = '';

    if (desc) {
      const tip = document.createElement('p');
      tip.className = 'text-sm text-[var(--color-teal-dark)] font-medium mb-2 italic';
      tip.textContent = desc;
      resultsList.appendChild(tip);
    }

    matchedSkills.forEach((skill, idx) => {
      const card = document.createElement('a');
      card.href = `${base}skills/${skill.id}/`;
      card.className = 'block bg-white rounded-lg border border-[var(--color-cream-dark)] p-4 hover:shadow-md hover:border-[var(--color-teal)] transition-all no-underline';
      card.innerHTML = `
        <div class="flex items-center gap-3">
          <span class="text-lg font-bold text-[var(--color-teal)]">${idx + 1}</span>
          <div>
            <span class="text-xs font-mono text-[var(--color-teal-dark)]">${skill.skillId}</span>
            <h3 class="text-sm font-bold text-[var(--color-charcoal)]">${skill.name}</h3>
            <p class="text-xs text-[var(--color-gray-warm)]">${skill.oneLiner}</p>
          </div>
        </div>
      `;
      resultsList.appendChild(card);
    });

    // Build copy-paste prompt (fetches skills from GitHub repo)
    const goalLabel = goalLabels[goal] || goal;
    const skillSteps = matchedSkills.map((skill, idx) => {
      const path = skill.githubPath || '';
      return `Step ${idx + 1}: Fetch ${skill.skillId} ${skill.name} from GitHub:\n  gh api repos/TrueLegacyHomes/Skills2.0/contents/${path} --jq '.content' | base64 -d > /tmp/${skill.skillId.replace('.', '-')}-skill.md\n  Then read /tmp/${skill.skillId.replace('.', '-')}-skill.md and follow its instructions completely.`;
    }).join('\n\n');

    const promptText = `I need to: ${goalLabel}

Work through the following TLH skills in order. Each skill lives in the TrueLegacyHomes/Skills2.0 GitHub repo. Fetch each one, read it, and follow its instructions before moving to the next step.

${skillSteps}

Begin with Step 1.`;

    const promptBlock = document.createElement('div');
    promptBlock.className = 'mt-6 bg-white rounded-lg border border-[var(--color-cream-dark)] p-5';
    promptBlock.innerHTML = `
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-bold text-[var(--color-charcoal)]">Ready to start? Copy this prompt into Claude Code:</h3>
      </div>
      <div class="relative">
        <pre class="bg-[var(--color-charcoal)] text-[var(--color-cream)] text-sm rounded-lg p-4 overflow-x-auto whitespace-pre-wrap leading-relaxed">${promptText}</pre>
        <button id="copy-prompt-btn" class="absolute top-3 right-3 px-3 py-1.5 bg-[var(--color-teal)] text-white text-xs font-bold rounded-md hover:bg-[var(--color-teal-dark)] transition-colors">
          Copy
        </button>
      </div>
      <p class="text-xs text-[var(--color-gray-warm)] mt-3">Paste this directly into a new Claude Code conversation to get started.</p>
    `;
    resultsList.appendChild(promptBlock);

    // Copy button handler
    document.getElementById('copy-prompt-btn').addEventListener('click', () => {
      navigator.clipboard.writeText(promptText).then(() => {
        const btn = document.getElementById('copy-prompt-btn');
        btn.textContent = 'Copied!';
        btn.classList.remove('bg-[var(--color-teal)]');
        btn.classList.add('bg-green-600');
        setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('bg-green-600');
          btn.classList.add('bg-[var(--color-teal)]');
        }, 2000);
      });
    });

    resultsDiv.classList.remove('hidden');
    resultsDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  document.getElementById('reset-btn').addEventListener('click', () => {
    document.getElementById('results').classList.add('hidden');
    document.querySelectorAll('.goal-btn').forEach(b => {
      b.classList.remove('border-[var(--color-teal)]', 'bg-[var(--color-teal-light)]');
    });
    // Clear the URL parameter
    const url = new URL(window.location);
    url.searchParams.delete('goal');
    window.history.replaceState({}, '', url);
  });

  // Auto-trigger if ?goal= is in the URL (from home page quick-start buttons)
  const urlParams = new URLSearchParams(window.location.search);
  const preselectedGoal = urlParams.get('goal');
  if (preselectedGoal && goalSkills[preselectedGoal]) {
    showResults(preselectedGoal);
  }
</script>
