---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'TLH AI Skill Hub — Your guide to every skill in the True Legacy Homes taxonomy.' } = Astro.props;
const base = import.meta.env.BASE_URL;

// Auth state (available on SSR pages via middleware, null on static pages)
const user = Astro.locals?.user ?? null;
const profile = Astro.locals?.profile ?? null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700;900&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href={`${base}leaf.png`} />
    <title>{title} | TLH Skill Hub</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Header -->
    <header class="bg-white border-b border-[var(--color-cream-dark)] sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <!-- Logo + Title -->
          <a href={base} class="flex items-center gap-3 no-underline">
            <img src={`${base}leaf-small.png`} alt="TLH" class="w-8 h-8 object-contain" />
            <div>
              <span class="text-lg font-bold text-[var(--color-charcoal)]">TLH Skill Hub</span>
              <span class="hidden sm:inline text-sm text-[var(--color-gray-warm)] ml-2">True Legacy Homes</span>
            </div>
          </a>

          <!-- Nav -->
          <nav class="flex items-center gap-1 sm:gap-2">
            <a href={`${base}catalog/`} class="px-3 py-2 rounded-lg text-sm font-medium text-[var(--color-charcoal)] hover:bg-[var(--color-teal-light)] hover:text-[var(--color-teal-dark)] transition-colors no-underline">
              Catalog
            </a>
            <a href={`${base}finder/`} class="px-3 py-2 rounded-lg text-sm font-medium text-[var(--color-charcoal)] hover:bg-[var(--color-teal-light)] hover:text-[var(--color-teal-dark)] transition-colors no-underline">
              Finder
            </a>
            <a href={`${base}workflows/`} class="px-3 py-2 rounded-lg text-sm font-medium text-[var(--color-charcoal)] hover:bg-[var(--color-teal-light)] hover:text-[var(--color-teal-dark)] transition-colors no-underline">
              Workflows
            </a>
            <span id="auth-nav-links" style={user ? '' : 'display:none'}>
              <span class="hidden sm:inline text-[var(--color-cream-dark)]">|</span>
              <a href={`${base}board/`} class="px-3 py-2 rounded-lg text-sm font-medium text-white bg-[var(--color-teal)] hover:bg-[var(--color-teal-dark)] transition-colors no-underline">
                Board
              </a>
              <a href={`${base}dashboard/`} class="px-3 py-2 rounded-lg text-sm font-medium text-[var(--color-charcoal)] hover:bg-[var(--color-teal-light)] hover:text-[var(--color-teal-dark)] transition-colors no-underline">
                Dashboard
              </a>
              {profile?.role === 'admin' && (
                <a href={`${base}admin/users/`} class="px-3 py-2 rounded-lg text-sm font-medium text-[var(--color-charcoal)] hover:bg-[var(--color-teal-light)] hover:text-[var(--color-teal-dark)] transition-colors no-underline">
                  Admin
                </a>
              )}
            </span>
            <div class="ml-2 flex items-center gap-1">
              {user && profile ? (
                <>
                  <div id="notification-bell-mount" data-user-id={profile.id}></div>
                  <div id="user-menu-mount" data-profile={JSON.stringify(profile)}></div>
                </>
              ) : (
                <a id="signin-link" href={`${base}login/`} class="px-4 py-2 text-sm font-medium text-white bg-[var(--color-navy)] rounded-lg hover:bg-[#0d3a63] transition-colors no-underline">
                  Sign In
                </a>
              )}
            </div>
          </nav>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Hydrate UserMenu if mount point exists -->
    <script>
      const mount = document.getElementById('user-menu-mount');
      if (mount) {
        const profileData = mount.dataset.profile;
        if (profileData) {
          import('../components/auth/UserMenu.tsx').then(({ default: UserMenu }) => {
            import('preact').then(({ render, h }) => {
              const profile = JSON.parse(profileData);
              render(h(UserMenu, { profile }), mount);
            });
          });
        }
      }

      // Hydrate NotificationBell
      const bellMount = document.getElementById('notification-bell-mount');
      if (bellMount) {
        const userId = bellMount.dataset.userId;
        if (userId) {
          import('../components/auth/NotificationBell.tsx').then(({ default: NotificationBell }) => {
            import('preact').then(({ render, h }) => {
              render(h(NotificationBell, { userId }), bellMount);
            });
          });
        }
      }

      // On static pages, auth nav links are hidden at build time.
      // Check client-side for a Supabase session and show them if logged in.
      const authNav = document.getElementById('auth-nav-links');
      const signInLink = document.getElementById('signin-link');
      if (authNav && authNav.style.display === 'none') {
        import('../lib/supabase').then(({ supabase }) => {
          supabase.auth.getSession().then(({ data: { session } }) => {
            if (session) {
              authNav.style.display = '';
              if (signInLink) signInLink.style.display = 'none';
            }
          });
        });
      }
    </script>

    <!-- Footer -->
    <footer class="bg-white border-t border-[var(--color-cream-dark)] py-6 mt-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center gap-2 text-sm text-[var(--color-gray-warm)]">
        <img src={`${base}leaf-small.png`} alt="TLH" class="w-6 h-6 object-contain opacity-50" />
        <p>For internal use only &middot; True Legacy Homes &middot; <span class="text-[var(--color-teal)]">Skill Taxonomy v1.0</span></p>
      </div>
    </footer>
  </body>
</html>
